# Financial Modeling Prep free-tier API key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# FRED (Federal Reserve Economic Data) free API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the default narrative model (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# SEC EDGAR requires a descriptive User-Agent identifying the requester (no personal email needed)
SEC_EDGAR_USER_AGENT=Beta1-Watchlist/1.0 (contact via GitHub repo issues)

# Optional, local-only: run the one AI call (pipeline/narrative/qualitative_client.py)
# against a local LM Studio server instead of Anthropic - see README's "Local
# generation with LM Studio". Leave unset/at "anthropic" for every normal run
# (including the automated weekly screen and the Vercel on-demand lookup, which
# can't reach a server on your own machine regardless of this setting).
QUALITATIVE_PROVIDER=anthropic
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model
# LMSTUDIO_TIMEOUT_SECONDS=300
# LMSTUDIO_JSON_MODE=1
