# Everything runs from app.py on your own computer - no cloud API keys needed.
# Copy this file to .env and adjust if your LM Studio setup differs from the
# defaults below.

# Base URL of LM Studio's local server (its "Developer" tab -> Start Server).
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# The exact model identifier LM Studio reports for the model you have loaded -
# check http://localhost:1234/v1/models (or LM Studio's own server tab) if the
# default below doesn't work.
LMSTUDIO_MODEL=local-model

# How long to wait for a local model response before giving up (seconds).
LMSTUDIO_TIMEOUT_SECONDS=120

# Most LM Studio/llama.cpp server builds support strict JSON responses, which
# makes a schema-following model far more likely to return clean JSON. Set to
# 0 if your server rejects the response_format field.
LMSTUDIO_JSON_MODE=1

# --- Market directory build-out (directory.py / sector_classify.py) ---

# SEC requires a real, reachable contact in the User-Agent on every request
# to their servers (their fair-access policy, not optional). Put your own
# name and email here - this only ever goes to SEC's servers, never
# committed anywhere.
SEC_CONTACT_EMAIL="Your Name your@email.com"

# Seconds to wait between each per-company sector lookup in
# sector_classify.py. Lower = faster but less polite to Yahoo's free,
# unofficial endpoint; raise it if you start seeing errored companies pile
# up.
SECTOR_FETCH_DELAY_SECONDS=0.4

# Same idea for build_filings.py's per-company SEC EDGAR lookups. SEC's
# documented fair-access limit is 10 requests/sec - 0.3s is comfortably
# under that even for companies that need an extra request or two for
# older filing pages.
FILINGS_FETCH_DELAY_SECONDS=0.3
