# Everything runs from app.py on your own computer - no cloud API keys needed.
# Copy this file to .env and adjust if your local LLM setup differs from the
# defaults below. Works with any OpenAI-compatible local server (Ollama,
# LM Studio, etc.) - defaults below are set for Ollama.

# Base URL of your local LLM server. Ollama: http://localhost:11434/v1
# (default below). LM Studio: http://localhost:1234/v1 (its "Developer" tab ->
# Start Server).
LLM_BASE_URL=http://localhost:11434/v1

# The exact model identifier your server reports for the model you have
# loaded/pulled. Ollama: whatever you ran `ollama pull` with (e.g.
# qwen2.5:7b) - check `ollama list`. LM Studio: check
# http://localhost:1234/v1/models or its own server tab.
LLM_MODEL=qwen2.5:7b

# How long to wait for a local model response before giving up (seconds).
LLM_TIMEOUT_SECONDS=120

# Most Ollama/LM Studio/llama.cpp server builds support strict JSON
# responses, which makes a schema-following model far more likely to return
# clean JSON. Set to 0 if your server rejects the response_format field.
LLM_JSON_MODE=1

# Starting point for characters per extracted filing section (MD&A, Risk
# Factors) sent to the local model in build_summaries.py. If the model
# reports a context-length error, this gets halved and retried
# automatically (down to a 1000-char floor) - so this doesn't need to be
# tuned per-model, just a reasonable starting guess. Raise it if your
# model handles long context well and you want fewer retries.
LLM_MAX_SECTION_CHARS=16000

# --- Market directory build-out (directory.py / sector_classify.py) ---

# SEC requires a real, reachable contact in the User-Agent on every request
# to their servers (their fair-access policy, not optional). Put your own
# name and email here - this only ever goes to SEC's servers, never
# committed anywhere.
SEC_CONTACT_EMAIL="Your Name your@email.com"

# Seconds to wait between each per-company sector lookup in
# sector_classify.py. Lower = faster but less polite to Yahoo's free,
# unofficial endpoint; raise it if you start seeing errored companies pile
# up.
SECTOR_FETCH_DELAY_SECONDS=0.4

# Same idea for build_filings.py's per-company SEC EDGAR lookups. SEC's
# documented fair-access limit is 10 requests/sec - 0.3s is comfortably
# under that even for companies that need an extra request or two for
# older filing pages.
FILINGS_FETCH_DELAY_SECONDS=0.3

# build_summaries.py: if the local LLM server's backend crashes mid-run, it
# often recovers on its own (the server auto-reloads the model on the next
# request) - these control how many times to wait and retry before giving
# up and stopping the whole batch for you to check on manually.
MODEL_CRASH_RETRY_ATTEMPTS=3
MODEL_CRASH_COOLDOWN_SECONDS=60
