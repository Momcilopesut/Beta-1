# Financial Modeling Prep free-tier API key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# FRED (Federal Reserve Economic Data) free API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the default narrative model (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# SEC EDGAR requires a descriptive User-Agent identifying the requester (no personal email needed)
SEC_EDGAR_USER_AGENT=Beta1-Watchlist/1.0 (contact via GitHub repo issues)
