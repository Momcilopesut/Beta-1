# Everything now runs from app.py on your own computer (see README's "Running
# the app") - no GitHub Actions secrets or Vercel project env vars to configure
# anymore, just this file.

# Optional - only needed if you pass --use-fmp (off by default). Free sources
# (SEC EDGAR + Stooq) cover price/statement/profile data on their own when run
# from your own machine; FMP is an opt-in precision upgrade, not a requirement.
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# FRED (Federal Reserve Economic Data) free API key, for the Macro Overview page:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Required only if QUALITATIVE_PROVIDER=anthropic (the default). Get one at
# https://console.anthropic.com/ - or set QUALITATIVE_PROVIDER=lmstudio below
# to skip needing this key at all.
ANTHROPIC_API_KEY=

# Optional: override the default narrative model (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# SEC EDGAR requires a descriptive User-Agent identifying the requester (no personal email needed)
SEC_EDGAR_USER_AGENT=Beta1-Watchlist/1.0 (contact via GitHub repo issues)

# Which provider runs the one AI call (moat read + filing summaries) - see
# README's "Local generation with LM Studio". "anthropic" (default) needs
# ANTHROPIC_API_KEY above and costs API spend; "lmstudio" runs entirely on
# your own machine via a local LM Studio server, for free.
QUALITATIVE_PROVIDER=anthropic
# QUALITATIVE_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model
# LMSTUDIO_TIMEOUT_SECONDS=300
# LMSTUDIO_JSON_MODE=1
